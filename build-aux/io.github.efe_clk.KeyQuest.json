{
  "id": "io.github.efe_clk.KeyQuest",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "keyquest",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/keyquest/cargo",
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "modules": [
    {
      "name": "keyquest",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --locked -p keyquest-gtk",
        "install -Dm755 target/release/keyquest -t /app/bin/",
        "install -Dm644 data/io.github.efe_clk.KeyQuest.desktop -t /app/share/applications/",
        "install -Dm644 data/io.github.efe_clk.KeyQuest.metainfo.xml -t /app/share/metainfo/",
        "install -Dm644 data/icons/io.github.efe_clk.KeyQuest.svg -t /app/share/icons/hicolor/scalable/apps/"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": ["target", ".git", ".flatpak-builder", "flatpak-build"]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
